From: Moonlight Windows ARM64 port
Subject: [PATCH] Add MSVC ARM64 SIMD/bitops support and Qualcomm native subgroup fallback

Enable ARM NEON headers and _CountOneBits/_CountOneBits64 intrinsics when
compiling Granite with MSVC for ARM64/ARM64EC, and allow Qualcomm Adreno
Vulkan drivers to use their native subgroup width when
requiredSubgroupSizeStages is zero.

diff --git a/Granite/math/simd_headers.hpp b/Granite/math/simd_headers.hpp
index 07dcefc3..ecee9997 100644
--- a/Granite/math/simd_headers.hpp
+++ b/Granite/math/simd_headers.hpp
@@ -35,6 +35,11 @@
 #define __AVX__ 1
 #endif
 
+#elif defined(_MSC_VER) && (defined(_M_ARM64) || defined(_M_ARM64EC))
+#include <arm_neon.h>
+#ifndef __ARM_NEON
+#define __ARM_NEON 1
+#endif
 #elif defined(__AVX__)
 #include <immintrin.h>
 #elif defined(__SSE4_1__)
diff --git a/Granite/util/bitops.hpp b/Granite/util/bitops.hpp
index 4bceaeb3..8a296305 100644
--- a/Granite/util/bitops.hpp
+++ b/Granite/util/bitops.hpp
@@ -52,12 +52,18 @@ namespace Internal
 {
 static inline uint32_t popcount32(uint32_t x)
 {
+#if defined(_M_ARM64) || defined(_M_ARM64EC)
+	return _CountOneBits(x);
+#else
 	return __popcnt(x);
+#endif
 }
 
 static inline uint32_t popcount64(uint64_t x)
 {
-#ifdef _WIN64
+#if defined(_M_ARM64) || defined(_M_ARM64EC)
+	return _CountOneBits64(x);
+#elif defined(_WIN64)
 	return __popcnt64(x);
 #else
 	return popcount32(uint32_t(x)) + popcount32(uint32_t(x >> 32));
diff --git a/Granite/vulkan/command_buffer.cpp b/Granite/vulkan/command_buffer.cpp
index 67371aaf..213adc8d 100644
--- a/Granite/vulkan/command_buffer.cpp
+++ b/Granite/vulkan/command_buffer.cpp
@@ -1255,9 +1255,10 @@ bool CommandBuffer::setup_subgroup_size_control(
 	else
 	{
 		// No varying-size flag and no required-size structure means the
-		// native subgroup size for our SPIR-V 1.3 shaders. MoltenVK exposes
-		// that mode even though requiredSubgroupSizeStages is zero.
-		if (features.driver_id == VK_DRIVER_ID_MOLTENVK &&
+		// native subgroup size for our SPIR-V 1.3 shaders. MoltenVK and
+		// Qualcomm Adreno drivers expose that mode when requiredSubgroupSizeStages is zero.
+		if ((features.driver_id == VK_DRIVER_ID_MOLTENVK ||
+		     features.driver_id == VK_DRIVER_ID_QUALCOMM_PROPRIETARY) &&
 		    !(features.vk13_props.requiredSubgroupSizeStages & stage))
 			return true;
 
diff --git a/Granite/vulkan/device.cpp b/Granite/vulkan/device.cpp
index 404eedaa..fa2a2192 100644
--- a/Granite/vulkan/device.cpp
+++ b/Granite/vulkan/device.cpp
@@ -5872,10 +5872,12 @@ bool Device::supports_subgroup_size_log2(bool subgroup_full_group, uint8_t subgr
 	}
 
 	// We need requiredSubgroupSizeStages support here.
-	// MoltenVK cannot request a subgroup size, but its ordinary SPIR-V 1.3
-	// pipelines use the reported native size when ALLOW_VARYING is absent.
-	// PyroWave's embedded shaders use that older SPIR-V contract.
-	if (ext.driver_id == VK_DRIVER_ID_MOLTENVK &&
+	// MoltenVK and some Qualcomm Adreno driver revisions cannot request a
+	// subgroup size, but their ordinary SPIR-V 1.3 pipelines use the reported
+	// native size when ALLOW_VARYING is absent. PyroWave's embedded shaders use
+	// that older SPIR-V contract.
+	if ((ext.driver_id == VK_DRIVER_ID_MOLTENVK ||
+	     ext.driver_id == VK_DRIVER_ID_QUALCOMM_PROPRIETARY) &&
 	    !(ext.vk13_props.requiredSubgroupSizeStages & stage))
 		return min_subgroups <= ext.vk11_props.subgroupSize &&
 		       max_subgroups >= ext.vk11_props.subgroupSize;
